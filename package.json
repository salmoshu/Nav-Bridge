{
  "name": "nav-bridge",
  "version": "0.1.1",
  "private": true,
  "description": "A desktop stream bridge for GNSS/navigation data.",
  "author": "salmos.hu",
  "main": "out/main/index.js",
  "packageManager": "pnpm@11.15.1",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build && electron-builder --publish never",
    "start": "electron-vite preview",
    "test": "jest --runInBand",
    "smoke": "electron-vite build && node scripts/run-electron-smoke.cjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist": "pnpm build",
    "dist:win": "pnpm build -- --win",
    "dist:mac": "pnpm build -- --mac",
    "dist:linux": "pnpm build -- --linux"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.8.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.9.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^39.2.7",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3",
    "vite": "^6.3.5"
  }
}
